{
  "name": "@library-app/source",
  "version": "0.0.0",
  "license": "MIT",
  "scripts": {
    "start": "npm run serve:all",
    "serve:all": "nx run-many --target=serve --projects=api,library --parallel=2 --output-style=static",
    "serve:web": "nx serve library --output-style=static",
    "serve:api": "nx serve api --output-style=static",
    "build": "nx run-many --target=build --projects=api,library --output-style=static",
    "build:web": "nx build library",
    "build:api": "nx build api",
    "test": "nx run-many --target=test --projects=api,library --output-style=static",
    "lint": "nx run-many --target=lint --projects=api,library,shared-models --output-style=static",
    "typecheck": "tsc -p apps/library/tsconfig.app.json --noEmit && tsc -p apps/api/tsconfig.app.json --noEmit && tsc -p libs/shared/models/tsconfig.lib.json --noEmit",
    "format": "nx format:write --all",
    "format:check": "nx format:check --all",
    "health:api": "curl -fsS http://localhost:3000/api/health",
    "check": "npm run lint && npm run typecheck && npm test && npm run build",
    "seed": "node --env-file-if-exists=.env tools/seed-books.mjs"
  },
  "private": true,
  "devDependencies": {
    "@angular-devkit/core": "^22.0.7",
    "@angular-devkit/schematics": "^22.0.7",
    "@angular/build": "^22.0.7",
    "@angular/cli": "^22.0.7",
    "@angular/compiler-cli": "^22.0.7",
    "@angular/language-service": "^22.0.7",
    "@eslint/js": "^10.0.1",
    "@nestjs/schematics": "^11.1.0",
    "@nestjs/testing": "^11.1.28",
    "@nx/angular": "23.1.0",
    "@nx/devkit": "23.1.0",
    "@nx/eslint": "23.1.0",
    "@nx/eslint-plugin": "23.1.0",
    "@nx/jest": "23.1.0",
    "@nx/js": "23.1.0",
    "@nx/nest": "23.1.0",
    "@nx/node": "23.1.0",
    "@nx/playwright": "23.1.0",
    "@nx/web": "23.1.0",
    "@nx/webpack": "23.1.0",
    "@nx/workspace": "23.1.0",
    "@playwright/test": "^1.37.0",
    "@schematics/angular": "^22.0.7",
    "@swc/helpers": "~0.5.18",
    "@types/express": "^5.0.6",
    "@types/jest": "~30.0.0",
    "@types/node": "^24.13.3",
    "@typescript-eslint/utils": "^8.58.0",
    "angular-eslint": "^22.0.0",
    "axios": "^1.18.1",
