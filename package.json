    "jest": "~30.4.2",
    "jest-environment-node": "~30.4.1",
    "jest-util": "~30.4.1",
    "jsdom": "^29.1.1",
    "nx": "23.1.0",
    "prettier": "~3.9.5",
    "ts-jest": "^29.4.7",
    "ts-node": "^10.9.2",
    "tslib": "^2.3.0",
